{
  "name": "sg208-button",
  "version": "0.1.0",
  "description": "A simple Vue3 component library of buttons",
  "author": "Syailendra Ginting (https://github.com/sg208)",
  "license": "MIT",
  "packageManager": "pnpm@10.34.8",
  "keywords": [
    "vue",
    "vue3",
    "component",
    "library",
    "button",
    "components"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "commonjs",
  "main": "./dist/sg208-button.umd.js",
  "module": "./dist/sg208-button.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sg208-button.mjs",
      "require": "./dist/sg208-button.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --config vite.demo.config.mts",
    "build:demo": "vite build --config vite.demo.config.mts",
    "preview:demo": "vite preview --config vite.demo.config.mts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run build:demo"
  },
  "peerDependencies": {
    "vue": "^3.2.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-css-in-js": "^1.3.1",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  }
}
